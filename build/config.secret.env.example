# =============================================================================
# config.secret.env — secrets, kept OUT of config.env so that file stays safe to
# share/commit. config.env sources this automatically if it exists.
#
#   cp config.secret.env.example config.secret.env   # then fill in real values
#
# This file is git-ignored. generate-cloud-init.sh embeds it into the build
# host's cloud-init when present, so Harvester auto-upload works unattended.
# =============================================================================

# Bearer token for the Harvester API. Get one from the UI:
#   Account & API Keys > Create API Key  (or a Harvester kubeconfig token).
export HARVESTER_TOKEN="ext/token-xxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

# Temporary local Administrator password used *only* during the build.
# cloudbase-init resets the real password from cloud metadata on first boot, so
# this never reaches production. Must satisfy Windows complexity rules.
export BUILD_ADMIN_PASSWORD="C0riolisBuild!2026"
