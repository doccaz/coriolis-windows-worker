# =============================================================================
# config.env — central configuration for the Coriolis Windows worker builder
# Sourced by every script in build/. Override any value via the environment.
# =============================================================================

# ---- Source images / installers --------------------------------------------
# Expected SHA256 checksums. Leave blank to skip verification (a warning is
# printed). Set them to catch a truncated/tampered download before it fails deep
# inside Windows setup. Pinned assets (the Server eval + VMDP release) have
# stable hashes; the cloudbase-init "Stable" MSI rolls, so it's left blank.
#
# Windows Server evaluation ISO (the OS the worker runs).
WIN_ISO_URL="${WIN_ISO_URL:-https://software-static.download.prss.microsoft.com/sg/download/888969d5-f34g-4e03-ac9d-1f9786c66749/SERVER_EVAL_x64FRE_en-us.iso}"
WIN_ISO_SHA256="${WIN_ISO_SHA256:-}"

# SUSE Virtual Machine Driver Pack (VMDP) — signed virtio drivers + qemu-ga.
VIRTIO_VMDP_URL="${VIRTIO_VMDP_URL:-https://github.com/SUSE/vmdp/releases/download/v2.5.5.1/VMDP-WIN-2.5.5.1-Community.iso}"
VIRTIO_VMDP_SHA256="${VIRTIO_VMDP_SHA256:-}"

# cloudbase-init MSI (the agent Coriolis drives on first boot).
CLOUDBASE_INIT_URL="${CLOUDBASE_INIT_URL:-https://www.cloudbase.it/downloads/CloudbaseInitSetup_Stable_x64.msi}"
CLOUDBASE_INIT_SHA256="${CLOUDBASE_INIT_SHA256:-}"

# ---- Windows install options -----------------------------------------------
# Image index inside the Server eval ISO's install.wim. Typical eval layout:
#   1 = Standard (Server Core)      2 = Standard (Desktop Experience)
#   3 = Datacenter (Server Core)    4 = Datacenter (Desktop Experience)
# The worker only needs Core, but Desktop Experience is the most compatible.
WIN_IMAGE_INDEX="${WIN_IMAGE_INDEX:-2}"

# Temporary local Administrator password used *only* during the build.
# Defined in config.secret.env (see the overlay at the bottom of this file);
# this fallback keeps the build working if you haven't created that file yet.
BUILD_ADMIN_PASSWORD="${BUILD_ADMIN_PASSWORD:-C0riolisBuild!2026}"

# ---- Build VM sizing (the throwaway Windows installer VM on the Leap host) --
BUILD_VM_NAME="${BUILD_VM_NAME:-coriolis-win-builder}"
BUILD_VM_RAM_MB="${BUILD_VM_RAM_MB:-6144}"
BUILD_VM_VCPUS="${BUILD_VM_VCPUS:-4}"
WORKER_DISK_SIZE="${WORKER_DISK_SIZE:-40G}"

# How long (seconds) to keep tapping ENTER so Windows boots from the install
# CD without a human pressing "Press any key to boot from CD or DVD".
CD_BOOT_KEYSPAM_SECONDS="${CD_BOOT_KEYSPAM_SECONDS:-90}"

# Max minutes to wait for the unattended install + sysprep to power the VM off.
BUILD_TIMEOUT_MINUTES="${BUILD_TIMEOUT_MINUTES:-120}"

# libvirt connection URI. The build talks to the *system* libvirtd so it shares
# the host's KVM/networking. A regular user can reach it without sudo as long as
# they're in the 'libvirt' group (and 'kvm' for acceleration) — so we point all
# bare `virsh` calls here instead of running the whole build as root. Exported
# so child virsh processes inherit it.
export LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

# ---- Paths / outputs --------------------------------------------------------
# Everything lives under the invoking user's home by default, NOT /var/lib —
# so the build runs end-to-end as a regular user and keeps the (often small)
# root partition free of the multi-GB ISOs and the captured qcow2. Override
# WORKDIR to point at any roomy, user-writable filesystem.
WORKDIR="${WORKDIR:-${HOME}/coriolis-worker-build}"
ASSETS_DIR="${ASSETS_DIR:-$WORKDIR/assets}"        # downloaded ISOs / MSI
OUTPUT_DIR="${OUTPUT_DIR:-$WORKDIR/output}"          # finished worker image
WORKER_IMAGE_NAME="${WORKER_IMAGE_NAME:-coriolis-windows-worker.qcow2}"

# Build log. Lives under WORKDIR (user-writable, off the root partition) rather
# than /var/log so a regular user can write and tail it without sudo.
LOG_FILE="${LOG_FILE:-$WORKDIR/coriolis-build.log}"

# Directory holding the Windows-side files (autounattend.xml, scripts, confs).
# Defaults to ../windows relative to the build/ scripts; the cloud-init image
# places them at /opt/coriolis-worker/windows.
WINDOWS_SRC_DIR="${WINDOWS_SRC_DIR:-/opt/coriolis-worker/windows}"

# ---- Auto-upload the finished image into Harvester (optional) ---------------
# When true, build-worker.sh runs upload-to-harvester.sh after capturing the
# image, registering it as a VirtualMachineImage (sourceType: upload).
UPLOAD_TO_HARVESTER="${UPLOAD_TO_HARVESTER:-false}"

# Harvester dashboard/API base URL, e.g. https://harvester.example.com
# (the VIP that serves the UI on :443, NOT the :6443 Kubernetes endpoint).
HARVESTER_SERVER="${HARVESTER_SERVER:-}"

# Bearer token for the Harvester API — set in config.secret.env, NOT here.
# This fallback leaves it empty so upload is simply skipped if no secret exists.
HARVESTER_TOKEN="${HARVESTER_TOKEN:-}"

# Where/what to register the image as.
HARVESTER_NAMESPACE="${HARVESTER_NAMESPACE:-default}"
HARVESTER_IMAGE_NAME="${HARVESTER_IMAGE_NAME:-coriolis-windows-worker}"
HARVESTER_IMAGE_DISPLAY="${HARVESTER_IMAGE_DISPLAY:-Coriolis Windows Worker}"

# Harvester usually serves a self-signed cert; set false only if it's trusted.
HARVESTER_INSECURE="${HARVESTER_INSECURE:-true}"

# ---- Secret overlay --------------------------------------------------------
# Load secrets (HARVESTER_TOKEN, BUILD_ADMIN_PASSWORD) from a separate,
# git-ignored file so this config stays safe to share. Sourced last, so the
# values it exports take precedence over the empty fallbacks above. If you'd
# rather inject secrets straight from the environment, just don't create the
# file. See config.secret.env.example.
_SECRET_ENV="$(dirname "${BASH_SOURCE[0]}")/config.secret.env"
[[ -f "$_SECRET_ENV" ]] && source "$_SECRET_ENV"
unset _SECRET_ENV
