# Real config — copy from config.env.example and fill in locally. Tunables only,
# but git-ignored so a token pasted directly into it can never be committed.
build/config.env

# Secrets (Harvester API token, build admin password). Copy from
# config.secret.env.example. Never commit.
build/config.secret.env

# Build artifacts / downloaded assets
coriolis-build-tmp/
output/
assets/
*.qcow2
*.iso
*.msi

# Generated cloud-init — a build artifact assembled by generate-cloud-init.sh
# from build/ + windows/. Not committed: it drifts from its sources and can
# embed a real build/config.env (Harvester token). Regenerate before deploying.
cloud-init/user-data.yaml
